{
  "name": "blackline-lead-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Automated qualified-lead generation for Cambridge Mews Accommodation",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --experimental-strip-types --import ./tests/register.mjs scripts/migrate.ts",
    "test": "node --test --experimental-strip-types --import ./tests/register.mjs tests/*.test.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "demo:seed": "node --experimental-strip-types --import ./tests/register.mjs scripts/demo-seed.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "geist": "^1.5.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.1.12",
    "@anthropic-ai/sdk": "^0.74.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.6"
  }
}

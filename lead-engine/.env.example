# BlackLine Lead Engine — configuration
#
# Every integration is opt-in. Anything left unset disables the feature that
# needs it and says so in the interface. Nothing is ever faked to fill a gap.

# --- Storage -----------------------------------------------------------------
# SQLite file, relative to the project root or absolute. The directory is
# created on first run. Needs a persistent disk — see docs/DEPLOYMENT.md.
DATABASE_FILE=data/lead-engine.db

# --- Discovery ---------------------------------------------------------------
# Web search provider. One of: serper, brave, tavily.
# Without this, discovery reports that it cannot search and stops.
SEARCH_PROVIDER=
SEARCH_API_KEY=

# --- Evidence extraction and outreach drafting -------------------------------
# Without a key, discovery cannot read sources. Outreach still works, falling
# back to the standard templates.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Alerts ------------------------------------------------------------------
# Where high-intent alerts are pushed (Slack incoming webhook, Zapier, n8n...).
# Unset means alerts appear in the app only.
NOTIFY_WEBHOOK_URL=
NOTIFY_EMAIL=

# --- Scheduled discovery -----------------------------------------------------
# Shared secret for /api/cron/* and the read-only /api/leads export.
# Unset means those endpoints refuse every request.
CRON_SECRET=

# --- Politeness --------------------------------------------------------------
# Advertised in the User-Agent when the engine fetches a page.
CRAWLER_CONTACT=contact@blacklineagency.co.uk

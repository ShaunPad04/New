# Serve mirrored media from public/assets/ instead of paul-fox.com.
# Run `npm run mirror-assets` first (needs access to www.paul-fox.com).
# NEXT_PUBLIC_ASSET_BASE=/assets/

# Powers the site assistant at /api/chat. Without it the widget shows the
# phone number instead of replying. Set it in Vercel for every environment.
# ANTHROPIC_API_KEY=sk-ant-...

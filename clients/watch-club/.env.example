# Enquiry delivery. Until this is set, /api/enquiry returns 501 and the form
# tells the visitor the truth rather than faking a successful send.
ENQUIRY_WEBHOOK_URL=

# Indexing is opt-in and production-only. Leave unset on every preview.
# The verify gate refuses to pass a build that sets this while the inventory
# is still demo data.
NEXT_PUBLIC_SITE_INDEXABLE=

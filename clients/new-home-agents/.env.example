# Copy to .env.local for development. Never commit real values.

# Public site origin — canonical URLs, Open Graph tags and the sitemap.
# Set to the final production domain when the site goes live.
NEXT_PUBLIC_SITE_URL="https://www.newhomeagents.co.uk"

# Indexing is OPT-IN. Set to "true" ONLY on the production deployment of the
# final domain. Preview builds leave this unset so robots.txt returns
# Disallow: / and every page carries noindex.
NEXT_PUBLIC_SITE_INDEXABLE="false"

# Where enquiry, valuation and registration submissions are delivered
# (a CRM webhook, Resend, Postmark, Zapier…). Until this is set the API
# route returns 501 and the forms show the telephone/email alternatives
# instead of a fake success state. Configure as a deployment secret.
ENQUIRY_WEBHOOK_URL=""

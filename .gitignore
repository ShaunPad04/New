# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# keep the env template committed
!.env.example

# Throwaway scratch scripts run from the repo root.
# Node resolves `@playwright/test` from the importing file's location, so a
# one-off Playwright script — a screenshot, a frame-timing probe, an audit —
# has to live here rather than in a temp directory. Dot-prefixed and ignored
# so the working tree stays clean while one is in flight, and so a crashed run
# never leaves a candidate for `git add -A`.
/.*.mjs

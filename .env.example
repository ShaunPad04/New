# Copy to .env.local for development. Never commit real values.

# Public site origin, used for canonical URLs, OG tags and the sitemap.
NEXT_PUBLIC_SITE_URL="https://blacklineagency.co.uk"

# Indexing is OPT-IN. Set to "true" ONLY on the production environment.
# Preview/staging must leave this unset so robots.txt returns Disallow: /.
NEXT_PUBLIC_SITE_INDEXABLE="false"

# ---------------------------------------------------------------------------
# ENQUIRY DELIVERY
#
# Until at least one of these is set, /api/enquiry returns 501 and the UI
# shows the direct email address rather than faking a success state.
# Set all of them as secrets in the Vercel dashboard, never in the repository.
# ---------------------------------------------------------------------------

# Resend API key. Create at https://resend.com/api-keys (free tier covers
# 3,000 emails a month, far beyond what an enquiry form needs).
RESEND_API_KEY=""

# Inbox that receives enquiries. Defaults to site.email in lib/content.ts.
ENQUIRY_EMAIL_TO="contact@blacklineagency.co.uk"

# The From address. Resend only sends from a domain verified in the account,
# so this stays on onboarding@resend.dev until blacklineagency.co.uk is
# verified there (add the DNS records Resend gives you, then switch this to
# e.g. "Black Line Agency Website <website@blacklineagency.co.uk>").
ENQUIRY_EMAIL_FROM=""

# Optional second destination — a CRM or automation endpoint. Runs in
# addition to the email, not instead of it.
ENQUIRY_WEBHOOK_URL=""

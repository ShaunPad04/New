# Copy to .env.local for development. Never commit real values.

# Public site origin, used for canonical URLs, OG tags and the sitemap.
NEXT_PUBLIC_SITE_URL="https://blacklineagency.co.uk"

# Indexing is OPT-IN. Set to "true" ONLY on the production environment.
# Preview/staging must leave this unset so robots.txt returns Disallow: /.
NEXT_PUBLIC_SITE_INDEXABLE="false"

# Where enquiry form submissions are delivered (Resend/Postmark/CRM webhook).
# Until this is set, /api/enquiry returns 501 and the UI shows the direct
# email address rather than faking a success state.
# Set this as a secret in the Vercel dashboard, never in the repository.
ENQUIRY_WEBHOOK_URL=""
